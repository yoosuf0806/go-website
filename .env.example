# Storefront (client-side, exposed to the browser via Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WHATSAPP_NUMBER=94XXXXXXXXX      # fallback; real value baked into snapshot from site_settings

# Build-time only (NOT exposed to the browser) — used by scripts/snapshot.ts.
# ALSO read server-side by api/payhere-notify.ts to mark an order paid via the
# service_role after verifying PayHere's signature. NEVER expose to the browser.
SUPABASE_SERVICE_KEY=                 # server-side read of catalogue during build; never in client bundle

# Server-side only (Vercel function env, NOT exposed to the browser) —
# read by api/publish.ts, never bundled into the client. The admin "Publish"
# button POSTs to /api/publish, which validates the caller (must be an admin)
# and fires this hook.
ADMIN_DEPLOY_HOOK_URL=                # Vercel Deploy Hook that rebuilds the storefront on "Publish"

# Server-side only (Vercel function env, NOT exposed to the browser) —
# read by api/payhere-notify.ts, the PayHere ITN handler. The merchant secret
# verifies that a payment-confirmation callback genuinely came from PayHere; it
# must never reach the client bundle. Leave blank until card payments go live
# (bank transfer is the launch method); the handler returns 503 until set.
PAYHERE_MERCHANT_ID=                  # PayHere merchant id (server-side signature check)
PAYHERE_MERCHANT_SECRET=              # PayHere merchant secret (server-side signature check)
